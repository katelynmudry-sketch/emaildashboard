# Copy this file to .env.local and fill in the values

# next-auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth — must be a Web Application type client (not Desktop)
# Create at: console.cloud.google.com > APIs & Services > Credentials
# Authorized redirect URI to add: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# Owner accounts (optional — personalizes the AI for your own use)
# If set, these addresses bypass the free tier and use CLINIC_CONTEXT below
NEXT_PUBLIC_OWNER_EMAIL=
NEXT_PUBLIC_OWNER_WORK_EMAIL=

# Owner AI context — paste your personal system prompt here (newlines as \n)
# If blank, a generic prompt is used for all users
CLINIC_CONTEXT=
