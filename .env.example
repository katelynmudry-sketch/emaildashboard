# Copy this file to .env.local and fill in the values

# next-auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth — must be a Web Application type client (not Desktop)
# Create at: console.cloud.google.com > APIs & Services > Credentials
# Authorized redirect URI to add: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# Google Picker (used by Settings -> Connectors -> TODO Export to pick/create
# a Google Doc). Create an API key at console.cloud.google.com > APIs &
# Services > Credentials, enable the "Google Picker API", and restrict the
# key by HTTP referrer to your app's domain(s).
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=

# Note: there is no env var for personalizing the AI prompt. Every account
# starts with the same generic system prompt; each user can write their own
# (or upload a .txt/.md file) from Settings -> AI System Prompt. It's stored
# only in their browser and sent only with their own requests.
