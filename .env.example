# Copy this file to .env.local and fill in the values

# next-auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth — must be a Web Application type client (not Desktop)
# Create at: console.cloud.google.com > APIs & Services > Credentials
# Authorized redirect URI to add: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic
ANTHROPIC_API_KEY=

# Supabase — create project at supabase.com, then find these under Project Settings -> API
# Run migrations/001_nextauth_schema.sql in the Supabase SQL editor before first use.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Found under Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=

# Email Party opt-in signups (separate Supabase project from the NextAuth one
# above) — table is public.emailparty_email_signups, RLS only allows anon INSERT.
EMAILPARTY_SUPABASE_URL=
EMAILPARTY_SUPABASE_ANON_KEY=

# Notion OAuth (Settings -> Connectors) — create public integration at notion.so/my-integrations
# Redirect URI to add: http://localhost:3000/api/connectors/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Todoist OAuth (Settings -> Connectors) — create app at developer.todoist.com/appconsole.html
# Redirect URI to add: http://localhost:3000/api/connectors/todoist/callback
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# Note: there is no env var for personalizing the AI prompt. Every account
# starts with the same generic system prompt; each user can write their own
# (or upload a .txt/.md file) from Settings -> AI System Prompt. It's stored
# only in their browser and sent only with their own requests.
